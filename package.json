{
  "name": "bauhaus-26-daemon-dargato",
  "version": "0.1.0",
  "description": "DARGATO - a procedural multiplayer cat navigation game for a live installation (Bauhaus DTAD WiSe 2026)",
  "license": "ISC",
  "author": "roy-mdr",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c gray,red \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "dev:https": "concurrently -k -n server,client -c gray,red \"npm:dev:server\" \"cross-env HTTPS=1 vite\"",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx scripts/test-worldgen.ts && tsx scripts/test-lifecycle.ts && tsx scripts/test-sim.ts",
    "test:worldgen": "tsx scripts/test-worldgen.ts",
    "test:sim": "tsx scripts/test-sim.ts",
    "bots": "tsx scripts/bots.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "cross-env": "^7.0.3",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.176.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.176.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
